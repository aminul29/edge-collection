{
  "manifest_version": 3,
  "name": "Edge Collections Sidebar",
  "version": "1.0.0",
  "description": "A sidebar extension that restores the Edge Collections feature with IndexedDB persistence and import backup support.",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "activeTab",
    "favicon",
    "scripting"
  ],
  "host_permissions": [
    "https://*.bing.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Collections Sidebar"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
