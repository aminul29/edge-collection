{
  "manifest_version": 3,
  "name": "Edge Collections Sidebar",
  "version": "1.0.0",
  "description": "A sidebar extension that restores the Edge Collections feature with IndexedDB persistence and import backup support.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "activeTab",
    "favicon",
    "scripting"
  ],
  "host_permissions": [
    "https://*.bing.com/*",
    "https://api.gumroad.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Collections Sidebar",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://api.gumroad.com;"
  }
}
